[
  {
    "id": "resilience-path",
    "title": "Resiliência: de timeout a cascading failure",
    "track": "Resilience",
    "level": "senior",
    "goal": "Entender cada ferramenta de resiliência pelo problema que ela resolve e pelo jeito como ela mesma pode piorar um incidente.",
    "steps": [
      {
        "ref": {
          "kind": "topics",
          "id": "resilience-patterns"
        },
        "why": "O mapa: timeout, retry, backoff, jitter, circuit breaker, fallback, degradação e backpressure."
      },
      {
        "ref": {
          "kind": "comparisons",
          "id": "timeout-vs-circuit-breaker"
        },
        "why": "Timeout protege a chamada; circuit breaker protege o sistema de insistir."
      },
      {
        "ref": {
          "kind": "failure-modes",
          "id": "retry-storm"
        },
        "why": "Retry é amplificação de carga: o laço timeout → retry → mais lentidão."
      },
      {
        "ref": {
          "kind": "failure-modes",
          "id": "thundering-herd"
        },
        "why": "Por que jitter: sincronização vs amplificação."
      },
      {
        "ref": {
          "kind": "comparisons",
          "id": "retry-storm-vs-thundering-herd"
        },
        "why": "Fixar a diferença de mecanismo e mitigação."
      },
      {
        "ref": {
          "kind": "patterns",
          "id": "circuit-breaker"
        },
        "why": "Estados, limiar e fallback."
      },
      {
        "ref": {
          "kind": "patterns",
          "id": "bulkhead"
        },
        "why": "Isolar recursos para conter blast radius."
      },
      {
        "ref": {
          "kind": "comparisons",
          "id": "rate-limiting-vs-backpressure-vs-load-shedding"
        },
        "why": "Quatro respostas diferentes para 'mais trabalho que capacidade'."
      },
      {
        "ref": {
          "kind": "failure-modes",
          "id": "cascading-failure"
        },
        "why": "Como tudo isso falha junto e por que o sistema não volta sozinho."
      },
      {
        "ref": {
          "kind": "incident-drills",
          "id": "drill-incident-timeline-root-cause"
        },
        "why": "Treinar causa raiz vs sintoma numa linha do tempo."
      }
    ],
    "sourceRefs": [
      {
        "kind": "pdf",
        "source": "System Design Workbook",
        "locator": "p.496-527",
        "note": "Ordem conceitual das estratégias de resiliência no workbook"
      },
      {
        "kind": "reference",
        "source": "Google SRE Book — Addressing Cascading Failures",
        "locator": "sre.google/sre-book/addressing-cascading-failures/",
        "note": "Retries, deadlines, load shedding e cascata",
        "url": "https://sre.google/sre-book/addressing-cascading-failures/"
      }
    ]
  },
